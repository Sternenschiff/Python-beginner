    def aufgabeIJ():
        print("feld wird neu erstellt, es werden alle 5 herum ersetzt")
        # Reihenfolge korrigiert: hoehe = Zeilen, breite = Spalten
        feld = [[random.randint(0, 9) for _ in range(breite)] for _ in range(hoehe)]
        s = Stack()
    
        for zeile in feld:
            print(zeile)
        
        for x in range(hoehe):
            for y in range(breite):
                if feld[x][y] == 5:
                    s.push((x, y))
                
        print("dies dient als abtrennung")
    
        # Koordinaten aus dem Stack holen (passe ggf. s.is_empty() an deine Stack-Klasse an)
        while not s.isEmpty(): 
            x, y = s.pop()
        
            if x > 0:
                feld[x - 1][y] = ":"
            if x < hoehe - 1:
                feld[x + 1][y] = ":"
            if y > 0:
                feld[x][y - 1] = ":"
            if y < breite - 1:
                feld[x][y + 1] = ":"
            
        for zeile in feld:
